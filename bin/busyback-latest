#!/bin/sh

for i in /mnt/OpenWRT_vaults/busyback_bank/4TBO* ; do 
   LAST=$(ls -l ${i}/*/last* 2>/dev/null )
   if [ -z "$LAST" ] ; then
      echo "no latest success: "${i##*/}
   fi
done 
ls -l $(find /mnt/OpenWRT_vaults/busyback_bank -maxdepth 3 | grep last) | \
    sed -e "s/^lrwxrwxrwx    1 root     root            [0-9][0-9] //;s/\/mnt\/OpenWRT_vaults\/busyback_bank\/.*\/manage\///" | \
    sort
